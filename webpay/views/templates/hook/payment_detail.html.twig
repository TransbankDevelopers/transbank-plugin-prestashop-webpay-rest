<div id="webpay_details" class="card">
	<div class="card-header">
		<h3>{{ title|e('html') }}</h3>
	</div>
	<div class="card-body">
		{% for data in dataView %}
			<div class="tbk-field">
				<span class="tbk-field-name">{{ data.label|e('html') }}:</span>
				<span class="tbk-field-value {{ data.class|e('html') }}">{{ data.value|e('html') }}</span>
			</div>
		{% endfor %}
	</div>
</div>
